  "repository": {
    "type": "git",
    "url": "git+https://github.com/gracelink-david/qingjiaowei-selfhost.git"
  },
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8789",
    "check": "tsc --noEmit",
    "dry-run": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.154.0"
  },
  "cloudflare": {
    "bindings": {
      "SETUP_CODE": {
        "description": "Make up your own one-time setup code (at least 8 characters). You will enter it once at /admin; do not use the example value. 自己编一个一次性设置码（至少 8 位），第一次打开 /admin 时输入；不要用示例值。"
      }
    }
  }
